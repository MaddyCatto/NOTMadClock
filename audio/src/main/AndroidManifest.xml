<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="com.madclock.audio.permission.CONTROL_AUDIO" android:protectionLevel="signature" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries><package android:name="com.madclock.app" /></queries>
    <application android:label="MadClock Audio" android:icon="@drawable/ic_alarm" android:allowBackup="false">
        <!-- No MAIN/LAUNCHER activity, shared UID, or task used for playback. -->
        <activity android:name=".SetupActivity" android:exported="true"
            android:permission="com.madclock.audio.permission.CONTROL_AUDIO"
            android:excludeFromRecents="true" android:theme="@style/AudioSetupTheme" />
        <service android:name=".AudioService" android:exported="true"
            android:permission="com.madclock.audio.permission.CONTROL_AUDIO"
            android:foregroundServiceType="mediaPlayback" android:stopWithTask="false" />
    </application>
</manifest>
