<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="com.madclock.audio.permission.CONTROL_AUDIO" android:protectionLevel="signature" />
    <uses-permission android:name="com.madclock.audio.permission.CONTROL_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries><package android:name="com.madclock.app" /></queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules" android:dataExtractionRules="@xml/data_extraction_rules">
        <activity android:name=".AudioInfoActivity" android:exported="true"
            android:excludeFromRecents="true" android:taskAffinity="" android:theme="@style/AudioInfoTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SetupActivity" android:exported="true"
            android:permission="com.madclock.audio.permission.CONTROL_AUDIO"
            android:excludeFromRecents="true" android:theme="@style/AudioSetupTheme" />
        <receiver android:name=".SleepStatusReceiver" android:exported="true"
            android:permission="com.madclock.audio.permission.CONTROL_AUDIO" />
        <service android:name=".AudioService" android:exported="true"
            android:permission="com.madclock.audio.permission.CONTROL_AUDIO"
            android:foregroundServiceType="mediaPlayback" android:stopWithTask="false" />
    </application>
</manifest>
