<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33E0BEFF">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="#3B255D" />
                    <stroke android:width="2dp" android:color="#B98BFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/card" />
                    <stroke android:width="1dp" android:color="@color/card_border" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
